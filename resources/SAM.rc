#include <winver.h>
#include "Version.h"

IDI_ICON1 ICON "SAM.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     SAM_VERSION_MAJOR, SAM_VERSION_MINOR, SAM_VERSION_PATCH, 0
PRODUCTVERSION  SAM_VERSION_MAJOR, SAM_VERSION_MINOR, SAM_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Gibbed"
            VALUE "FileDescription",  "Steam Achievement Manager"
            VALUE "FileVersion",      SAM_VERSION_STRING
            VALUE "LegalCopyright",   "Copyright (c) 2024 Rick (rick 'at' gibbed 'dot' us)"
            VALUE "ProductName",      "Steam Achievement Manager"
            VALUE "ProductVersion",   SAM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
